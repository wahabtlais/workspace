# Example Nginx server block for the CodeBrave prototype (static single-page app).
# Copy, then replace the placeholders. Nothing here is specific to any server.
#
#   prototype.example.org      -> your domain
#   /var/www/codebrave/current -> the folder that contains index.html (the contents of dist/)
#
# HTTPS: add your certificate configuration (for example via Certbot), or terminate TLS
# in a reverse proxy in front of this server.

server {
    listen 80;
    server_name prototype.example.org;

    root /var/www/codebrave/current;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # Optional password protection (recommended).
    # Create the file with:  htpasswd -c /etc/nginx/.htpasswd-codebrave reviewer
    # auth_basic           "CodeBrave prototype";
    # auth_basic_user_file /etc/nginx/.htpasswd-codebrave;

    add_header X-Robots-Tag "noindex, nofollow" always;

    # Built files have content hashes in their names: cache for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # SPA fallback: serve index.html for any path that is not a real file,
    # so direct links and page refreshes on nested routes work.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ /index.html;
    }
}
